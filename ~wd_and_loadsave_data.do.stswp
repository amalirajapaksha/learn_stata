clear all

pwd

cd C:\Users\MSI\OneDrive\Desktop\intern\learn_stata

import excel GN_Level_Population_by_Ethnic_Group_cleaned.xlsx, firstrow clear

describe Sinhalese Total

list Sinhalese in 1/20

count if trim(Sinhalese) == "-"

replace Sinhalese = "" if trim(Sinhalese) == "-"

destring Sinhalese, replace

describe Sinhalese

generate Sinhalese_percentage = (Sinhalese / Total) * 100